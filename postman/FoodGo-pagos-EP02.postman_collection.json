                  "pm.test(\"Campos guardados\", () => { const expected = JSON.parse(pm.variables.replaceIn(pm.request.body.raw)); const actual = pm.response.json(); Object.keys(expected).forEach(key => pm.expect(actual[key]).to.eql(key === \"email\" ? expected[key].toLowerCase() : expected[key])); });"

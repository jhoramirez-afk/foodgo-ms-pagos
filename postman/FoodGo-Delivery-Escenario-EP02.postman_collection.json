    {
      "name": "01 Pedido completo: datos ficticios coherentes",
      "item": [
        {
          "name": "01 Registrar a Camila Soto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{url_usuarios}}/api/usuarios",
            "description": "Respuesta esperada: HTTP 201. Datos ficticios para la EP02.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Camila Soto\",\n  \"rol\": \"CLIENTE\",\n  \"email\": \"camila.soto.{{runTag}}@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runTag\", Date.now().toString(36).toUpperCase() + \"-\" + pm.variables.replaceIn(\"{{$randomUUID}}\").replace(/-/g, \"\").slice(0, 8).toUpperCase());",
                  "const ayer = Date.now() - 24*60*60*1000;",
                  "pm.collectionVariables.set(\"fechaDemo\", new Date(ayer).toISOString().slice(0,19));",
                  "pm.collectionVariables.set(\"fechaDemoActualizada\", new Date(ayer + 5*60*1000).toISOString().slice(0,19));",
                  "pm.collectionVariables.set(\"fechaDemoFinal\", new Date(ayer + 20*60*1000).toISOString().slice(0,19));",
                  "pm.collectionVariables.unset(\"usuarioId\");",
                  "pm.collectionVariables.unset(\"direccionId\");",
                  "pm.collectionVariables.unset(\"restauranteId\");",
                  "pm.collectionVariables.unset(\"productoId\");",
                  "pm.collectionVariables.unset(\"pedidoId\");",
                  "pm.collectionVariables.unset(\"detalleId\");",
                  "pm.collectionVariables.unset(\"cuponId\");",
                  "pm.collectionVariables.unset(\"usoId\");",
                  "pm.collectionVariables.unset(\"pagoId\");",
                  "pm.collectionVariables.unset(\"transaccionId\");",
                  "pm.collectionVariables.unset(\"envioId\");",
                  "pm.collectionVariables.unset(\"trackingId\");",
                  "pm.collectionVariables.unset(\"notificacionId\");",
                  "pm.collectionVariables.unset(\"intentoId\");",
                  "pm.collectionVariables.unset(\"resenaId\");",
                  "pm.collectionVariables.unset(\"respuestaId\");",
                  "pm.collectionVariables.unset(\"subtotalPedido\");",
                  "pm.collectionVariables.unset(\"totalAPagar\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"ID generado\", () => pm.expect(Number.isInteger(pm.response.json().id) && pm.response.json().id > 0).to.eql(true));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"usuarioId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
